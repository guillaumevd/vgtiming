{
  "name": "vg-timing",
  "version": "0.0.7",
  "description": "VG-Timing - Application de chronométrage professionnel",
  "author": {
    "name": "Guillaume Vandriessche",
    "email": "Guillaumevandriessche776@gmail.com"
  },
  "main": "app/app.js",
  "homepage": "./",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillaumevd/vgtiming.git"
  },
  "scripts": {
    "start": "npm run dev",
    "build": "npm run build:clean && npm run build:react && npm run build:electron",
    "build:clean": "rimraf build dist",
    "build:react": "cross-env GENERATE_SOURCEMAP=false SKIP_PREFLIGHT_CHECK=true craco build",
    "build:electron": "electron-builder",
    "build:win": "npm run build:clean && npm run build:react && electron-builder --win",
    "build:mac": "npm run build:clean && npm run build:react && electron-builder --mac",
    "build:linux": "npm run build:clean && npm run build:react && electron-builder --linux",
    "dist": "npm run build",
    "pack": "npm run build:react && electron-builder --dir",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-rebuild",
    "dev": "concurrently \"wait-on tcp:127.0.0.1:3000 && cross-env NODE_ENV=dev NODE_NO_WARNINGS=1 NODE_OPTIONS=--no-warnings electron .\" \"cross-env BROWSER=none PORT=3000 DISABLE_ESLINT_PLUGIN=true NODE_NO_WARNINGS=1 NODE_OPTIONS=--no-warnings GENERATE_SOURCEMAP=false craco start\""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "dependencies": {
    "@electron/remote": "1.0.2",
    "@fortawesome/fontawesome-free": "^7.0.0",
    "better-sqlite3": "^12.2.0",
    "bootstrap": "^5.2.3",
    "chart.js": "^4.5.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.6.2",
    "exceljs": "^4.4.0",
    "joi": "^18.0.0",
    "moment": "^2.29.4",
    "pdfkit": "^0.17.1",
    "react-to-print": "^3.1.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0-0",
    "@babel/plugin-syntax-flow": "^7.14.5",
    "@babel/plugin-transform-react-jsx": "^7.14.9",
    "@craco/craco": "^7.1.0",
    "@popperjs/core": "^2.11.7",
    "concurrently": "^8.0.1",
    "cross-env": "^7.0.3",
    "electron": "^29.4.6",
    "electron-builder": "^25.1.7",
    "electron-rebuild": "^3.2.9",
    "framer-motion": "^10.10.0",
    "graceful-fs": "^4.2.11",
    "node-fetch": "^3.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": ">=16.8.0",
    "react-router": "^6.10.0",
    "react-router-dom": "^6.10.0",
    "react-scripts": "^5.0.1",
    "rimraf": "^5.0.5",
    "styled-components": "^5.3.9",
    "typescript": "^4.9.5",
    "wait-on": "^8.0.4",
    "web-vitals": "^3.3.0"
  },
  "overrides": {
    "nth-check": ">=2.0.1",
    "postcss": ">=8.4.31",
    "svgo": ">=2.0.0",
    "webpack-dev-server": "^4.15.2"
  }
}
